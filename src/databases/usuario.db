-- Ínidices

-- Estado
CREATE INDEX idx_usuario_estatus ON usuario."tUsuario" (id_estatus_usuario);

-- Acceso
CREATE INDEX idx_acceso_id_usuario ON usuario."tAcceso" (id_usuario);
CREATE INDEX idx_acceso_bloqueo ON usuario."tAcceso" (bloqueado_hasta) WHERE bloqueado_hasta IS NOT NULL;
 
-- Log
CREATE INDEX idx_log_fecha ON usuario."lUsuario" (fecha_error_log);
CREATE INDEX idx_log_usuario ON usuario."lUsuario" (id_usuario);
CREATE INDEX idx_log_ip ON usuario."lUsuario" (ip_address);
 
-- Sesiones
CREATE INDEX idx_sesion_usuario ON usuario."tSesion" (id_usuario);
CREATE INDEX idx_sesion_expires ON usuario."tSesion" (expires_at);
CREATE INDEX idx_sesion_token_hash ON usuario."tSesion" (refresh_token_hash);
CREATE INDEX idx_sesion_revoked ON usuario."tSesion" (revoked) WHERE revoked = FALSE;


-- Funciones

-- Registrar usuario
CREATE OR REPLACE FUNCTION usuario.registrar_usuario(
    _nombre_usuario     VARCHAR,
    _correo_electronico VARCHAR,
    _contrasena_hash    TEXT,
    _id_rol_usuario     INT
)
RETURNS JSON AS $$
DECLARE
    nuevo_id  INT;
    resultado JSON;
BEGIN
    -- Validaciones básicas
    IF _nombre_usuario IS NULL OR trim(_nombre_usuario) = '' THEN
        RAISE EXCEPTION 'El nombre de usuario es obligatorio';
    END IF;

    IF _correo_electronico IS NULL
       OR _correo_electronico !~ '^[^@\s]+@[^@\s]+\.[^@\s]+$' THEN
        RAISE EXCEPTION 'Correo electrónico inválido';
    END IF;

    IF _contrasena_hash IS NULL OR trim(_contrasena_hash) = '' THEN
        RAISE EXCEPTION 'La contraseña es obligatoria';
    END IF;

    IF NOT EXISTS (
        SELECT 1 FROM usuario."tRolUsuario"
        WHERE id_rol = _id_rol_usuario AND estatus_rol = TRUE
    ) THEN
        RAISE EXCEPTION 'El rol especificado no existe o está inactivo';
    END IF;

    IF EXISTS (
        SELECT 1 FROM usuario."tUsuario"
        WHERE correo_electronico = lower(_correo_electronico)
    ) THEN
        RAISE EXCEPTION 'Ya existe un usuario registrado con ese correo electrónico';
    END IF;

    -- Insert
    INSERT INTO usuario."tUsuario" (
        nombre_usuario, correo_electronico, contrasena_hash, id_rol_usuario
    ) VALUES (
        _nombre_usuario, lower(_correo_electronico), _contrasena_hash, _id_rol_usuario
    )
    RETURNING id_usuario INTO nuevo_id;

    INSERT INTO usuario."tAcceso" (id_usuario) VALUES (nuevo_id);

    SELECT json_build_object(
        'id',                 nuevo_id,
        'nombre_usuario',     _nombre_usuario,
        'correo_electronico', lower(_correo_electronico)
    ) INTO resultado;

    RETURN resultado;

EXCEPTION
    WHEN unique_violation THEN
        RAISE EXCEPTION 'Ya existe un usuario registrado con ese correo electrónico';
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;


-- Permisos de acceso
GRANT USAGE ON SCHEMA usuario TO anon, authenticated, service_role;
GRANT ALL ON ALL TABLES IN SCHEMA usuario TO anon, authenticated, service_role;
ALTER DEFAULT PRIVILEGES IN SCHEMA usuario
GRANT ALL ON TABLES TO anon, authenticated, service_role;