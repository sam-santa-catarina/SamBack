CREATE SCHEMA IF NOT EXISTS sistema;

CREATE TABLE sistema."lSistema" (
    id_log_sistema INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    id_usuario INT NULL REFERENCES usuario."tUsuario"(id_usuario) ON DELETE SET NULL,
    mensaje_error VARCHAR(500),
    detalle_error TEXT,
    clase VARCHAR(100),
    metodo VARCHAR(100),
    ip_address INET,
    user_agent TEXT,
    fecha_error_log TIMESTAMPTZ DEFAULT NOW()
);

CREATE TABLE sistema."tAuditoria" (
    id_auditoria BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    id_usuario INT NULL REFERENCES usuario."tUsuario"(id_usuario) ON DELETE SET NULL,
    accion VARCHAR(100) NOT NULL,  -- 'register', 'login', 'email_verify', 'password_reset'...
    entidad VARCHAR(50),           -- 'tUsuario', 'tSesion', 'tCodigosVerificacion'
    entidad_id INT,
    detalles JSONB,
    ip_address INET,
    user_agent TEXT,
    fecha TIMESTAMPTZ DEFAULT NOW()
);


-- Índices útiles
CREATE INDEX idx_auditoria_usuario ON sistema."tAuditoria" (id_usuario);
CREATE INDEX idx_auditoria_accion ON sistema."tAuditoria" (accion);
CREATE INDEX idx_auditoria_fecha ON sistema."tAuditoria" (fecha);

CREATE INDEX idx_log_fecha ON sistema."lSistema" (fecha_error_log);
CREATE INDEX idx_log_usuario ON sistema."lSistema" (id_usuario);
CREATE INDEX idx_log_ip ON sistema."lSistema" (ip_address);


-- Permisos
GRANT USAGE ON SCHEMA sistema TO anon, authenticated, service_role;
GRANT ALL ON ALL TABLES IN SCHEMA sistema TO anon, authenticated, service_role;
ALTER DEFAULT PRIVILEGES IN SCHEMA sistema GRANT ALL ON TABLES TO anon, authenticated, service_role;